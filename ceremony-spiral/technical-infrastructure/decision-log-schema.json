{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Ceremony Spiral Decision Log Schema",
  "description": "Schema for documenting decisions with relational accountability",
  "type": "object",
  "required": [
    "id",
    "timestamp",
    "decision",
    "decision_makers",
    "perspectives_considered",
    "rationale",
    "relational_impact",
    "reversibility"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique identifier for the decision (UUID recommended)",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "timestamp": {
      "type": "string",
      "description": "ISO 8601 timestamp of when decision was made",
      "format": "date-time"
    },
    "decision": {
      "type": "string",
      "description": "What was decided (clear, concise statement)"
    },
    "decision_makers": {
      "type": "array",
      "description": "People who participated in making this decision",
      "items": {
        "type": "object",
        "required": ["name", "role"],
        "properties": {
          "name": {
            "type": "string",
            "description": "Name of decision maker"
          },
          "role": {
            "type": "string",
            "description": "Their role in the decision (e.g., 'Strategic Lead', 'Community Representative')"
          }
        }
      },
      "minItems": 1
    },
    "perspectives_considered": {
      "type": "object",
      "description": "Multiple perspectives that informed this decision",
      "properties": {
        "technical": {
          "type": "string",
          "description": "Technical considerations and constraints"
        },
        "community": {
          "type": "string",
          "description": "Community impact and Indigenous perspectives"
        },
        "business": {
          "type": "string",
          "description": "Business and revenue considerations"
        },
        "partnership": {
          "type": "string",
          "description": "Partnership and stakeholder considerations"
        },
        "research": {
          "type": "string",
          "description": "Academic and research perspectives"
        },
        "product": {
          "type": "string",
          "description": "User experience and product considerations"
        }
      },
      "minProperties": 2
    },
    "rationale": {
      "type": "array",
      "description": "Reasons why this path was chosen",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "relational_impact": {
      "type": "object",
      "description": "How this decision affects relationships and accountability",
      "required": ["affected_parties", "how_honoring", "accountability_maintained"],
      "properties": {
        "affected_parties": {
          "type": "array",
          "description": "Who is affected by this decision",
          "items": {
            "type": "string"
          }
        },
        "how_honoring": {
          "type": "string",
          "description": "How we're honoring relationships in this decision"
        },
        "accountability_maintained": {
          "type": "string",
          "description": "What accountability mechanisms are in place"
        }
      }
    },
    "reversibility": {
      "type": "object",
      "description": "How easily can this decision be changed",
      "required": ["ease", "triggers", "revisit_date"],
      "properties": {
        "ease": {
          "type": "string",
          "enum": ["high", "medium", "low"],
          "description": "How easily can we change course"
        },
        "triggers": {
          "type": "array",
          "description": "What would trigger a reconsideration",
          "items": {
            "type": "string"
          }
        },
        "revisit_date": {
          "type": "string",
          "format": "date",
          "description": "When we'll revisit this decision"
        }
      }
    },
    "phase": {
      "type": "string",
      "description": "Which phase of development this decision relates to",
      "enum": ["Phase 1: Foundational", "Phase 2: Development", "Phase 3: Pilot", "Phase 4: Scale", "Cross-Phase"]
    },
    "decision_type": {
      "type": "string",
      "description": "Category of decision",
      "enum": [
        "Strategic",
        "Technical Architecture",
        "Team & Roles",
        "Partnership",
        "Community Engagement",
        "Product",
        "Budget",
        "Timeline",
        "Go/No-Go"
      ]
    },
    "tags": {
      "type": "array",
      "description": "Tags for querying and filtering",
      "items": {
        "type": "string"
      }
    },
    "related_decisions": {
      "type": "array",
      "description": "IDs of related decisions",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
      }
    },
    "status": {
      "type": "string",
      "description": "Current status of the decision",
      "enum": ["proposed", "decided", "implementing", "revisited", "reversed"],
      "default": "decided"
    },
    "notes": {
      "type": "string",
      "description": "Additional notes or context"
    }
  }
}
